---
import { ui } from '@/data/i18n';
import { profile } from '@/data/profile';
import T from './T.astro';

interface Props {
  /** Sur une page projet, les liens pointent vers les sections de l'accueil. */
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';
const nav = [
  { href: `${base}#work`, label: ui.nav.work },
  { href: `${base}#open-source`, label: ui.nav.oss },
  { href: `${base}#about`, label: ui.nav.about },
  { href: `${base}#stack`, label: ui.nav.stack },
  { href: `${base}#contact`, label: ui.nav.contact },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-line data-[scrolled]:bg-bg/75 data-[scrolled]:backdrop-blur-xl" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label={`${profile.name} — accueil`}>
      <span class="grid size-8 place-items-center rounded-lg bg-fg font-mono text-[13px] font-bold text-bg transition-transform group-hover:-rotate-6">RK</span>
      <span class="hidden text-[15px] font-medium tracking-tight sm:block">{profile.name}</span>
    </a>

    <nav class="hidden md:block" aria-label="Navigation">
      <ul class="flex items-center gap-1 rounded-full border border-line bg-white/[0.02] p-1">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="block rounded-full px-4 py-1.5 text-sm text-muted transition-colors hover:bg-white/[0.06] hover:text-fg">
                <T t={item.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-lang-toggle
        class="rounded-full border border-line px-3 py-1.5 font-mono text-xs tracking-wider text-muted transition-colors hover:border-line-strong hover:text-fg"
        aria-label="Changer de langue / Switch language"
      >
        <span data-i18n="fr">EN</span><span data-i18n="en">FR</span>
      </button>
      <a href={`${base}#contact`} class="hidden rounded-full bg-fg px-4 py-1.5 text-sm font-medium text-bg transition-opacity hover:opacity-85 sm:inline-block">
        <T t={ui.hero.contact} />
      </a>
      <details class="relative md:hidden" data-menu>
        <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full border border-line text-muted [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-2xl border border-line bg-elev/95 p-2 shadow-2xl backdrop-blur-xl">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block rounded-xl px-3 py-2.5 text-sm text-muted hover:bg-white/[0.06] hover:text-fg">
                  <T t={item.label} />
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</header>
