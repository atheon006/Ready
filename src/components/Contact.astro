---
import { ui } from '@/data/i18n';
import { profile } from '@/data/profile';
import Arrow from './Arrow.astro';
import T from './T.astro';
---

<section id="contact" class="container-page pb-20 md:pb-28" aria-labelledby="contact-title">
  <div class="relative overflow-hidden rounded-[32px] border border-line bg-elev px-6 py-16 md:px-16 md:py-24" data-reveal>
    <div class="pointer-events-none absolute -top-40 -right-32 size-[34rem] rounded-full bg-[radial-gradient(closest-side,rgb(255_122_48/0.20),transparent)]" aria-hidden="true"></div>
    <p class="eyebrow relative"><T t={ui.contact.eyebrow} /></p>
    <h2 id="contact-title" class="relative mt-5 max-w-3xl text-4xl font-semibold tracking-[-0.035em] text-balance md:text-6xl">
      <T t={ui.contact.title} />
    </h2>
    <p class="relative mt-6 max-w-xl text-lg text-muted"><T t={ui.contact.text} /></p>

    <div class="relative mt-10 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-[15px] font-medium text-bg transition-transform hover:-translate-y-0.5">
        {profile.email}
        <Arrow dir="up-right" class="size-4" />
      </a>
      <button
        type="button"
        data-copy={profile.email}
        class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-3 text-[15px] font-medium transition-colors hover:bg-white/[0.05]"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        <span data-copy-label><T t={ui.contact.copy} /></span>
        <span data-copy-done hidden><T t={ui.contact.copied} /></span>
      </button>
    </div>

    <ul class="relative mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-8">
      {
        profile.links
          .filter((l) => !l.url.startsWith('mailto:'))
          .map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-muted transition-colors hover:text-fg">
                <span class="social-icon size-4" set:html={l.icon} />
                {l.label}
                <Arrow dir="up-right" class="size-3.5 opacity-60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </a>
            </li>
          ))
      }
    </ul>
  </div>
</section>
