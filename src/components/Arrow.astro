---
interface Props {
  dir?: 'up-right' | 'right' | 'left';
  class?: string;
}
const { dir = 'right', class: cls = 'size-4' } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {dir === 'up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {dir === 'right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {dir === 'left' && <path d="M19 12H5M11 18l-6-6 6-6" />}
</svg>
