---
import { ui } from '@/data/i18n';
import type { Status } from '@/data/projects';
import T from './T.astro';

interface Props {
  status: Status;
}
const { status } = Astro.props;
const dot = { live: 'bg-ok', beta: 'bg-accent', prototype: 'bg-dim', archived: 'bg-dim' }[status];
---

<span class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-xs tracking-wide text-muted">
  <span class:list={['size-1.5 rounded-full', dot]} aria-hidden="true"></span>
  <T t={ui.status[status]} />
</span>
