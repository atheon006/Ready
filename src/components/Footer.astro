---
import { ui } from '@/data/i18n';
import { profile } from '@/data/profile';
import T from './T.astro';
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-4 py-10 text-sm text-dim md:flex-row md:items-center md:justify-between">
    <p>© {new Date().getFullYear()} {profile.name} ({profile.alias}). <T t={ui.footer.built} /></p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        profile.links.map((l) => (
          <li>
            <a href={l.url} target={l.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="transition-colors hover:text-fg">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
