---
import { ui } from '@/data/i18n';
import { profile } from '@/data/profile';
import T from './T.astro';
---

<section id="about" class="border-y border-line bg-elev/60" aria-labelledby="about-title">
  <div class="container-page grid gap-14 py-20 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-6" data-reveal>
      <p class="eyebrow"><T t={ui.about.eyebrow} /></p>
      <h2 id="about-title" class="mt-4 text-4xl font-semibold tracking-[-0.03em] md:text-5xl">{profile.name}</h2>
      <div class="mt-8 space-y-5 text-[17px] leading-relaxed text-pretty text-muted">
        {profile.about.map((p) => <p><T t={p} /></p>)}
      </div>
    </div>

    <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--reveal-delay: 120ms">
      <h3 class="font-mono text-xs tracking-[0.14em] text-dim uppercase"><T t={ui.about.focus} /></h3>
      <ol class="mt-6 divide-y divide-line border-y border-line">
        {
          profile.focus.map((f, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-2 py-5">
              <span class="font-mono text-sm text-accent-ink">0{i + 1}</span>
              <div>
                <p class="font-medium"><T t={f.title} /></p>
                <p class="mt-1 text-[15px] leading-relaxed text-muted"><T t={f.text} /></p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
