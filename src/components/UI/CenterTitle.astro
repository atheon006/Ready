---
type Props = {
    title: string;
    color?: "primary" | "secondary";
    i18nKey?: string;
};
const { title, color, i18nKey }: Props = Astro.props;
---

<div
    class={`Fade_Up Title-Tag Title_Line relative flex_center text-[2em] ${color}`}
>
    <span>{"<"}</span>
    <p data-i18n={i18nKey}>{title}</p>
    <span>{"/>"}</span>
</div>
